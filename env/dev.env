# ─────────────────────────────────────────────────────────────────────────────
# FraudPreventionSystem — Dev Environment
# ─────────────────────────────────────────────────────────────────────────────
# Usage: Deployed via Terraform (environments/dev)
# Secrets via AWS Secrets Manager
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment ──────────────────────────────────────────────────────────────
ENVIRONMENT=dev

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_DB=fraud_db
POSTGRES_USER=fraud_user
# POSTGRES_PASSWORD=          # via AWS Secrets Manager

# ── Backend (Spring Boot) ───────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
SPRING_SECURITY_USER_NAME=fraud_admin
# SPRING_SECURITY_USER_PASSWORD=  # via AWS Secrets Manager
# JWT_SECRET=                     # via AWS Secrets Manager
SPRING_DATASOURCE_URL=jdbc:postgresql://${RDS_ENDPOINT}:5432/fraud_db
SPRING_DATASOURCE_USERNAME=fraud_user
SPRING_REDIS_HOST=${REDIS_ENDPOINT}
SPRING_REDIS_PORT=6379
SPRING_KAFKA_BOOTSTRAP_SERVERS=${KAFKA_BROKERS}

# ── ML Service (FastAPI) ────────────────────────────────────────────────────
LLM_PROVIDER=mock
# ANTHROPIC_API_KEY=          # via AWS Secrets Manager
DATABASE_URL=postgresql://fraud_user@${RDS_ENDPOINT}:5432/fraud_db
REDIS_URL=redis://${REDIS_ENDPOINT}:6379
KAFKA_BOOTSTRAP_SERVERS=${KAFKA_BROKERS}

# ── MLflow ───────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://mlflow:5000

# ── Firebase Auth ────────────────────────────────────────────────────────────
# FIREBASE_CONFIG=            # via GCP outputs
