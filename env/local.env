# ─────────────────────────────────────────────────────────────────────────────
# FraudPreventionSystem — Local Development Environment
# ─────────────────────────────────────────────────────────────────────────────
# Usage: cp env/local.env .env && make up
# Secrets via Doppler: doppler run -- docker compose up -d
# ─────────────────────────────────────────────────────────────────────────────

# ── Doppler ──────────────────────────────────────────────────────────────────
DOPPLER_PROJECT=fraud-prevention
DOPPLER_CONFIG=dev_main

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_DB=fraud_db
POSTGRES_USER=fraud_user
# POSTGRES_PASSWORD=          # via Doppler

# ── Redis ────────────────────────────────────────────────────────────────────
# REDIS_PASSWORD=             # via Doppler (empty = no auth for local)

# ── Backend (Spring Boot) ───────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=local
SPRING_SECURITY_USER_NAME=fraud_admin
# SPRING_SECURITY_USER_PASSWORD=  # via Doppler
# JWT_SECRET=                     # via Doppler
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/fraud_db
SPRING_DATASOURCE_USERNAME=fraud_user
SPRING_REDIS_HOST=redis
SPRING_REDIS_PORT=6379
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# ── ML Service (FastAPI) ────────────────────────────────────────────────────
LLM_PROVIDER=mock
# ANTHROPIC_API_KEY=          # via Doppler (only when LLM_PROVIDER=anthropic)
DATABASE_URL=postgresql://fraud_user@postgres:5432/fraud_db
REDIS_URL=redis://redis:6379
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# ── MLflow ───────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://mlflow:5000

# ── Ports ────────────────────────────────────────────────────────────────────
# Postgres:   5432
# Redis:      6379
# Kafka:      9092
# Backend:    8080
# ML Service: 8001
# MLflow:     5001
# Frontend:   4200
